# Copy to web/.env.local for local runs; set the same names in Vercel > Settings > Environment Variables.
GEMINI_API_KEY=
# Optional: override the Gemini model if the default is not available on your key.
GEMINI_MODEL=
# Live tab: NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# Place search in the region picker: Google Maps Platform key with Places API (New) or Geocoding API enabled.
GOOGLE_MAPS_API_KEY=
